# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ===================================================================
# Server Configuration
# ===================================================================
PORT=3000
API_KEY=your-secret-api-key-change-this

# ===================================================================
# Multi-Database Configuration
# ===================================================================

# Option 1: Use a configuration file (recommended for multiple databases)
# Path to databases.json configuration file
DATABASES_JSON=/path/to/databases.json

# Option 2: Configure databases using environment variables
# Format: DATABASE_<INDEX>_<PROPERTY>=value
#
# Properties:
#   id      - Unique identifier for this database (required)
#   type    - Database type: mysql or mongodb (required)
#   mode    - Access mode: read-only or read-write (default: read-write)
#   host    - MySQL host (for mysql type)
#   port    - MySQL port (for mysql type, default: 3306)
#   user    - MySQL username (for mysql type)
#   password - MySQL password (for mysql type)
#   database - Database/collection name (required)
#   url     - MongoDB connection string (for mongodb type)

# Example: Production read-only MySQL database
DATABASE_0_ID=prod_read
DATABASE_0_TYPE=mysql
DATABASE_0_MODE=read-only
DATABASE_0_HOST=prod-db.example.com
DATABASE_0_PORT=3306
DATABASE_0_USER=readonly_user
DATABASE_0_PASSWORD=your_prod_read_password
DATABASE_0_DATABASE=production

# Example: Production read-write MySQL database
DATABASE_1_ID=prod_write
DATABASE_1_TYPE=mysql
DATABASE_1_MODE=read-write
DATABASE_1_HOST=prod-db.example.com
DATABASE_1_PORT=3306
DATABASE_1_USER=write_user
DATABASE_1_PASSWORD=your_prod_write_password
DATABASE_1_DATABASE=production

# Example: Staging MySQL database
DATABASE_2_ID=staging
DATABASE_2_TYPE=mysql
DATABASE_2_MODE=read-write
DATABASE_2_HOST=staging-db.example.com
DATABASE_2_PORT=3306
DATABASE_2_USER=staging_user
DATABASE_2_PASSWORD=your_staging_password
DATABASE_2_DATABASE=staging

# Example: MongoDB analytics database (read-only)
DATABASE_3_ID=analytics
DATABASE_3_TYPE=mongodb
DATABASE_3_MODE=read-only
DATABASE_3_URL=mongodb://analytics.example.com:27017
DATABASE_3_DATABASE=analytics

# ===================================================================
# Legacy Single-Database Configuration (Backward Compatibility)
# ===================================================================
# If no DATABASES_JSON or DATABASE_* variables are set, the server
# will fall back to this legacy configuration format.

# MySQL Configuration (Required for legacy mode)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-database-name

# MongoDB Configuration (Optional for legacy mode)
MONGO_ENABLED=false
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=your-mongo-database
